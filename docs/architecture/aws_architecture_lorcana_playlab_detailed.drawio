<mxCell id="eat" value="public IPv4 (แจกอัตโนมัติจาก subnet)&lt;br&gt;SG lorcana-ec2-sg:&lt;br&gt;ขาเข้า: TCP 80 จาก ALB SG เท่านั้น&lt;br&gt;ขาออก: ทั้งหมด&lt;br&gt;ไม่เปิด 22" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="490" y="235" width="185" height="215" as="geometry"/></mxCell>
