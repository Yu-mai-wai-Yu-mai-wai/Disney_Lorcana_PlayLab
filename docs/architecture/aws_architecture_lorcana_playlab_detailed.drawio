<mxCell id="e2a" value="② forward" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeWidth=2;dashed=0;strokeColor=#1F6FEB;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="alb" target="ec2a"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e2b" value="② forward" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeWidth=2;dashed=0;strokeColor=#1F6FEB;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="alb" target="ec2b"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e3a" value="③ บูต: อ่าน secret" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeWidth=2;dashed=1;strokeColor=#6B7280;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.2;entryX=0;entryY=0.5;" edge="1" parent="1" source="ec2a" target="ssm"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e3b" value="③ บูต: ดึงโค้ด" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeWidth=2;dashed=1;strokeColor=#6B7280;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.4;entryX=0;entryY=0.5;" edge="1" parent="1" source="ec2a" target="s3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e4" value="④ HTTPS (AWS SDK) Get/Put/Query" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeWidth=2;dashed=0;strokeColor=#1F6FEB;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.85;" edge="1" parent="1" source="ec2b" target="gddb"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="905" y="566"/><mxPoint x="905" y="820"/><mxPoint x="1770" y="820"/><mxPoint x="1770" y="480"/></Array></mxGeometry></mxCell>
<mxCell id="e5" value="⑤ TCP 6379 cache-aside" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeWidth=2;dashed=0;strokeColor=#1F6FEB;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.7;entryX=1;entryY=0.5;" edge="1" parent="1" source="ec2b" target="cache"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e6" value="⑥ POST /decks → SendMessage (async)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeWidth=2;dashed=0;strokeColor=#ED7100;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.8;entryX=0;entryY=0.5;" edge="1" parent="1" source="ec2a" target="sqsd"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="905" y="323"/><mxPoint x="905" y="125"/><mxPoint x="1190" y="125"/><mxPoint x="1190" y="195"/></Array></mxGeometry></mxCell>
<mxCell id="e7a" value="⑦ ดึงงาน (event source mapping)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeWidth=2;dashed=0;strokeColor=#ED7100;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="sqsd" target="lama"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e7b" value="⑦ UpdateItem analysis" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeWidth=2;dashed=0;strokeColor=#ED7100;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="lama" target="tdecks"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e7c" value="ล้ม 3 ครั้ง" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeWidth=2;dashed=1;strokeColor=#D13212;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="sqsd" target="dlqd"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e8" value="⑧ POST /matches → Publish" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeWidth=2;dashed=0;strokeColor=#ED7100;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="ec2b" target="sns"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e9a" value="⑨ Fan-Out" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeWidth=2;dashed=0;strokeColor=#ED7100;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="sns" target="sqsh"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e9b" value="⑨ Fan-Out" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeWidth=2;dashed=0;strokeColor=#ED7100;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="sns" target="sqss"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e10a" value="⑩ ดึงงาน" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeWidth=2;dashed=0;strokeColor=#ED7100;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="sqsh" target="lamh"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e10b" value="⑩ PutItem x2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeWidth=2;dashed=0;strokeColor=#ED7100;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="lamh" target="thist"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e11a" value="⑪ ดึงงาน" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeWidth=2;dashed=0;strokeColor=#ED7100;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="sqss" target="lams"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e11b" value="⑪ ADD wins/games" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeWidth=2;dashed=0;strokeColor=#ED7100;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="lams" target="tstats"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e12" value="⑫ WSS (เกม 2 คน)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeWidth=2;dashed=0;strokeColor=#2DA44E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="c1" target="apigw"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="90" y="880"/><mxPoint x="1000" y="880"/><mxPoint x="1000" y="685"/></Array></mxGeometry></mxCell>
<mxCell id="e13" value="⑬ invoke ตาม route" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeWidth=2;dashed=0;strokeColor=#2DA44E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.35;entryX=0;entryY=0.35;" edge="1" parent="1" source="apigw" target="lamr"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e14a" value="⑭ สถานะห้อง" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeWidth=2;dashed=0;strokeColor=#2DA44E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.35;entryX=0;entryY=0.5;" edge="1" parent="1" source="lamr" target="troom"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e14b" value="⑭ คิวจับคู่" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeWidth=2;dashed=0;strokeColor=#2DA44E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.8;entryX=0;entryY=0.5;" edge="1" parent="1" source="lamr" target="tmm"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e15" value="⑮ PostToConnection (relay)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeWidth=2;dashed=1;strokeColor=#2DA44E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.8;entryX=1;entryY=0.8;" edge="1" parent="1" source="lamr" target="apigw"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e16" value="⑯ alarm → scaling policy" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeWidth=2;dashed=0;strokeColor=#8C4FFF;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;" edge="1" parent="1" source="cw" target="gasg"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

<diagram id="p2" name="2 EC2 + ElastiCache">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1700" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="เจาะลึก: EC2 (Nginx + Node.js) และ ElastiCache" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1200" height="34" as="geometry"/></mxCell>
        <mxCell id="t2" value="A = ลำดับบูตเครื่อง | B = เส้นทางคำขอภายในเครื่อง | C = ตารางอันดับแบบ cache-aside | D = Security Group และ Auto Scaling" style="text;html=1;fontSize=12;align=left;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="20" y="44" width="1500" height="24" as="geometry"/></mxCell>

        <mxCell id="ha" value="A. ลำดับบูต (User Data ทำงานตอน ASG สร้างเครื่อง)" style="text;html=1;fontSize=14;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="80" width="460" height="26" as="geometry"/></mxCell>
        <mxCell id="b1" value="&lt;b&gt;1 เตรียมโฟลเดอร์&lt;/b&gt;&lt;br&gt;mkdir /var/www/lorcana-web และ /var/www/lorcana-backend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2E0;strokeColor=#ED7100;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="20" y="115" width="420" height="70" as="geometry"/></mxCell>
        <mxCell id="b2" value="&lt;b&gt;2 ดึงโค้ดจาก S3&lt;/b&gt; (สิทธิ์จาก LabInstanceProfile)&lt;br&gt;aws s3 sync bucket static → /var/www/lorcana-web (SPA)&lt;br&gt;aws s3 cp bucket assets/server.cjs → /var/www/lorcana-backend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2E0;strokeColor=#ED7100;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="20" y="215" width="420" height="90" as="geometry"/></mxCell>
        <mxCell id="b3" value="&lt;b&gt;3 อ่านค่าลับจาก SSM /lorcana/*&lt;/b&gt;&lt;br&gt;เขียนเป็น env file ให้ systemd (jwt-secret, URL คิว, ARN topic, endpoint แคช)&lt;br&gt;ถ้าอ่านไม่ได้ = ไม่สร้าง env file = backend ไม่เริ่ม (fail closed)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDE7F1;strokeColor=#E7157B;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="20" y="335" width="420" height="90" as="geometry"/></mxCell>
        <mxCell id="b4" value="&lt;b&gt;4 เริ่ม systemd lorcana-backend&lt;/b&gt;&lt;br&gt;รัน server.cjs ที่พอร์ต 3001 (PORT=3001 ใน systemd)&lt;br&gt;cluster.ts fork 1 worker ต่อ vCPU; Restart=always" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2E0;strokeColor=#ED7100;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="20" y="455" width="420" height="80" as="geometry"/></mxCell>
        <mxCell id="b5" value="&lt;b&gt;5 ตั้งค่า Nginx :80 แล้ว restart&lt;/b&gt;&lt;br&gt;gzip เปิด; /health ตอบโดย nginx เอง; /api/ → proxy_pass 127.0.0.1:3001&lt;br&gt;/assets/ ตั้ง Cache-Control public, max-age=31536000, immutable" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2E0;strokeColor=#ED7100;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="20" y="565" width="420" height="90" as="geometry"/></mxCell>
        <mxCell id="b6" value="&lt;b&gt;6 ALB ตรวจ /api/health&lt;/b&gt;&lt;br&gt;ผ่าน = target healthy เริ่มรับทราฟฟิก&lt;br&gt;ไม่ผ่านต่อเนื่อง = ถอดออกและ ASG สร้างเครื่องแทน" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE3FF;strokeColor=#8C4FFF;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="20" y="685" width="420" height="80" as="geometry"/></mxCell>
        <mxCell id="ba1" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;strokeColor=#6B7280;" edge="1" parent="1" source="b1" target="b2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ba2" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;strokeColor=#6B7280;" edge="1" parent="1" source="b2" target="b3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ba3" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;strokeColor=#6B7280;" edge="1" parent="1" source="b3" target="b4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ba4" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;strokeColor=#6B7280;" edge="1" parent="1" source="b4" target="b5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ba5" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;strokeColor=#6B7280;" edge="1" parent="1" source="b5" target="b6"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="hb" value="B. เส้นทางคำขอภายใน EC2 หนึ่งเครื่อง" style="text;html=1;fontSize=14;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="500" y="80" width="460" height="26" as="geometry"/></mxCell>
        <mxCell id="n0" value="ALB (HTTP :80)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE3FF;strokeColor=#8C4FFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="500" y="115" width="300" height="50" as="geometry"/></mxCell>
        <mxCell id="n1" value="&lt;b&gt;Nginx :80&lt;/b&gt;&lt;br&gt;/  → ไฟล์ SPA ใน /var/www/lorcana-web (try_files แล้วตกไป index.html)&lt;br&gt;/assets/ → ไฟล์มี hash, cache 1 ปี, gzip&lt;br&gt;/api/ → proxy_pass ไป Node :3001&lt;br&gt;/health → nginx ตอบ 200 เอง ไม่เข้า Node" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2E0;strokeColor=#ED7100;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="500" y="205" width="300" height="140" as="geometry"/></mxCell>
        <mxCell id="n2" value="&lt;b&gt;Node.js Express (cluster, 1 worker ต่อ vCPU)&lt;/b&gt;&lt;br&gt;1 express.json จำกัดขนาด 2 MB&lt;br&gt;2 authenticateToken: อ่าน Bearer JWT, ล็อก HS256, แนบ req.user&lt;br&gt;3 requireAdmin: ตรวจ role = admin (เฉพาะ /admin/*)&lt;br&gt;4 route handler ตรวจ input เองทีละ route" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2E0;strokeColor=#ED7100;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="500" y="385" width="300" height="150" as="geometry"/></mxCell>
        <mxCell id="n3" value="&lt;b&gt;กลุ่ม route&lt;/b&gt;&lt;br&gt;ไม่ต้อง JWT: POST /auth/register, POST /auth/login, GET /leaderboard, GET /users/:u/stats, GET /api/health&lt;br&gt;ต้อง JWT: /decks (POST, GET, DELETE, analyze, analysis), POST/GET /matches, /users/me/playmat&lt;br&gt;ต้อง JWT + admin: /admin/billing, /admin/elevate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#4B5563;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="500" y="575" width="300" height="140" as="geometry"/></mxCell>
        <mxCell id="n4" value="AWS SDK (HTTPS): DynamoDB, SQS, SNS | ioredis (TCP 6379): ElastiCache" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EAFB;strokeColor=#3B48CC;fontSize=11;" vertex="1" parent="1"><mxGeometry x="500" y="745" width="300" height="50" as="geometry"/></mxCell>
        <mxCell id="nb0" value="forward" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;strokeColor=#1F6FEB;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n0" target="n1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="nb1" value="/api/* proxy :3001" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;strokeColor=#1F6FEB;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n1" target="n2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="nb2" value="ผ่านด่าน" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;strokeColor=#1F6FEB;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n2" target="n3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="nb3" value="เรียกบริการ AWS" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;strokeColor=#1F6FEB;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n3" target="n4"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="hc" value="C. GET /api/leaderboard แบบ cache-aside (ElastiCache Redis)" style="text;html=1;fontSize=14;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="880" y="80" width="560" height="26" as="geometry"/></mxCell>
        <mxCell id="l1" value="&lt;b&gt;① คำขอเข้า&lt;/b&gt; GET /api/leaderboard (ไม่ต้อง JWT)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#4B5563;fontSize=11;" vertex="1" parent="1"><mxGeometry x="880" y="115" width="330" height="55" as="geometry"/></mxCell>
        <mxCell id="l2" value="&lt;b&gt;② ตรวจแคช&lt;/b&gt; ioredis GET lorcana:leaderboard:v1&lt;br&gt;(ปิด offline queue, ไม่ retry จึงล้มเร็ว)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EAFB;strokeColor=#3B48CC;fontSize=11;" vertex="1" parent="1"><mxGeometry x="880" y="205" width="330" height="65" as="geometry"/></mxCell>
        <mxCell id="lhit" value="&lt;b&gt;พบ (HIT)&lt;/b&gt;&lt;br&gt;ตอบทันที header X-Cache: HIT&lt;br&gt;ประมาณ 1 ms (Stage 3)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F7EC;strokeColor=#3F8624;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1270" y="205" width="260" height="65" as="geometry"/></mxCell>
        <mxCell id="lmiss" value="&lt;b&gt;③ ไม่พบ (MISS)&lt;/b&gt;&lt;br&gt;Scan LorcanaPlayerStats เรียงตามชนะ เอา 25 อันดับแรก" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EAFB;strokeColor=#3B48CC;fontSize=11;" vertex="1" parent="1"><mxGeometry x="880" y="315" width="330" height="65" as="geometry"/></mxCell>
        <mxCell id="lset" value="&lt;b&gt;④ เขียนแคช&lt;/b&gt; SET lorcana:leaderboard:v1 EX 60&lt;br&gt;และ ZADD lorcana:leaderboard:zset (ตรวจอันดับ)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EAFB;strokeColor=#3B48CC;fontSize=11;" vertex="1" parent="1"><mxGeometry x="880" y="425" width="330" height="65" as="geometry"/></mxCell>
        <mxCell id="lresp" value="&lt;b&gt;⑤ ตอบ&lt;/b&gt; X-Cache: MISS&lt;br&gt;ประมาณ 41 ms (Stage 3) คำขอถัดไปใน 60 วินาทีจะ HIT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2E0;strokeColor=#ED7100;fontSize=11;" vertex="1" parent="1"><mxGeometry x="880" y="535" width="330" height="65" as="geometry"/></mxCell>
        <mxCell id="ldown" value="&lt;b&gt;Redis ล่มหรือเชื่อมไม่ได้&lt;/b&gt;&lt;br&gt;ข้ามแคช อ่าน DynamoDB ตรง ตอบ HTTP 200 (graceful degradation ทดสอบใน Stage 3)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDE7F1;strokeColor=#E7157B;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1270" y="315" width="260" height="85" as="geometry"/></mxCell>
        <mxCell id="lcache" value="&lt;b&gt;ElastiCache Redis lorcana-cache&lt;/b&gt;&lt;br&gt;engine redis, cache.t3.micro, 1 โหนด, :6379&lt;br&gt;SG รับเฉพาะจาก EC2 SG&lt;br&gt;ไม่มี replica หรือ Multi-AZ&lt;br&gt;ข้อมูลหายเมื่อโหนดรีสตาร์ต (ไม่เป็นปัญหา เพราะเป็นแคช)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EAFB;strokeColor=#3B48CC;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1270" y="445" width="260" height="130" as="geometry"/></mxCell>
        <mxCell id="lc1" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;strokeColor=#1F6FEB;" edge="1" parent="1" source="l1" target="l2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="lc2" value="พบ" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;strokeColor=#3F8624;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="l2" target="lhit"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="lc3" value="ไม่พบ" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;strokeColor=#1F6FEB;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="l2" target="lmiss"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="lc4" value="error" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;dashed=1;strokeColor=#E7157B;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="l2" target="ldown"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1240" y="290"/><mxPoint x="1400" y="290"/></Array></mxGeometry></mxCell>
        <mxCell id="lc5" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;strokeColor=#1F6FEB;" edge="1" parent="1" source="lmiss" target="lset"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="lc6" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;strokeColor=#1F6FEB;" edge="1" parent="1" source="lset" target="lresp"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="lc7" value="SET / ZADD" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;strokeColor=#3B48CC;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="lset" target="lcache"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="hd" value="D. Security Group และ Auto Scaling" style="text;html=1;fontSize=14;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="880" y="640" width="500" height="26" as="geometry"/></mxCell>
        <mxCell id="sg" value="&lt;b&gt;Security Group (ยืนยันจากสคริปต์และ console)&lt;/b&gt;&lt;br&gt;ALB SG: รับ TCP 80 จาก 0.0.0.0/0&lt;br&gt;EC2 SG: รับ TCP 80 จาก ALB SG เท่านั้น ไม่เปิดพอร์ต 22&lt;br&gt;Cache SG: รับ TCP 6379 จาก EC2 SG เท่านั้น&lt;br&gt;EC2 มี public IPv4 และออกอินเทอร์เน็ตผ่าน IGW (ไม่มี NAT, ไม่มี VPC Endpoint)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F9F5FF;strokeColor=#8C4FFF;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="880" y="675" width="330" height="140" as="geometry"/></mxCell>
        <mxCell id="asgb" value="&lt;b&gt;Auto Scaling (lorcana-asg)&lt;/b&gt;&lt;br&gt;Min 2 / Desired 2 / Max 4, EC2 กระจาย 1a และ 1b&lt;br&gt;Target tracking ASGAverageCPUUtilization = 60%&lt;br&gt;ผลทดสอบ 2026-10-12 (เวลาไทย): 11:22 ขยาย 2→3, 11:28 ขยาย 3→4, 11:44 และ 11:46 ลดเหลือ 2&lt;br&gt;Alarm lorcana-unhealthy-hosts (UnHealthyHostCount มากกว่า 0)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2E0;strokeColor=#ED7100;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1230" y="675" width="330" height="140" as="geometry"/></mxCell>
<mxCell id="ic_s3" value="" style="sketch=0;outlineConnect=0;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;" vertex="1" parent="1"><mxGeometry x="450" y="238" width="44" height="44" as="geometry"/></mxCell>
<mxCell id="ic_ssm" value="" style="sketch=0;outlineConnect=0;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.systems_manager;" vertex="1" parent="1"><mxGeometry x="450" y="358" width="44" height="44" as="geometry"/></mxCell>
<mxCell id="ic_ec2a" value="" style="sketch=0;outlineConnect=0;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ec2;" vertex="1" parent="1"><mxGeometry x="450" y="473" width="44" height="44" as="geometry"/></mxCell>
<mxCell id="ic_ec2b" value="" style="sketch=0;outlineConnect=0;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ec2;" vertex="1" parent="1"><mxGeometry x="450" y="588" width="44" height="44" as="geometry"/></mxCell>
<mxCell id="ic_alb6" value="" style="sketch=0;outlineConnect=0;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.application_load_balancer;" vertex="1" parent="1"><mxGeometry x="450" y="703" width="44" height="44" as="geometry"/></mxCell>
<mxCell id="ic_alb0" value="" style="sketch=0;outlineConnect=0;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.application_load_balancer;" vertex="1" parent="1"><mxGeometry x="812" y="118" width="44" height="44" as="geometry"/></mxCell>
<mxCell id="ic_ngx" value="" style="sketch=0;outlineConnect=0;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ec2;" vertex="1" parent="1"><mxGeometry x="812" y="253" width="44" height="44" as="geometry"/></mxCell>
<mxCell id="ic_node" value="" style="sketch=0;outlineConnect=0;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ec2;" vertex="1" parent="1"><mxGeometry x="812" y="438" width="44" height="44" as="geometry"/></mxCell>
<mxCell id="ic_ddb2" value="" style="sketch=0;outlineConnect=0;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;" vertex="1" parent="1"><mxGeometry x="812" y="748" width="44" height="44" as="geometry"/></mxCell>
<mxCell id="ic_ddbm" value="" style="sketch=0;outlineConnect=0;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;" vertex="1" parent="1"><mxGeometry x="1216" y="325" width="44" height="44" as="geometry"/></mxCell>
<mxCell id="ic_cache" value="" style="sketch=0;outlineConnect=0;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.elasticache;" vertex="1" parent="1"><mxGeometry x="1538" y="470" width="44" height="44" as="geometry"/></mxCell>
<mxCell id="ic_asg" value="" style="sketch=0;outlineConnect=0;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ec2;" vertex="1" parent="1"><mxGeometry x="1566" y="700" width="44" height="44" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="p3" name="3 Lambda เจาะลึก">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1800" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="เจาะลึก: Lambda ทั้ง 4 ตัว (trigger → ขั้นตอนทำงาน → ปลายทาง → การจัดการข้อผิดพลาด)" style="text;html=1;fontSize=22;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1500" height="34" as="geometry"/></mxCell>

        <mxCell id="r1t" value="&lt;b&gt;Trigger&lt;/b&gt;&lt;br&gt;API Gateway WebSocket (stage prod)&lt;br&gt;route: $connect, $disconnect, $default" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDE7F1;strokeColor=#E7157B;fontSize=11;align=left;spacingLeft=8;spacingRight=64;" vertex="1" parent="1"><mxGeometry x="20" y="80" width="240" height="110" as="geometry"/></mxCell>
        <mxCell id="r1c" value="&lt;b&gt;1. Lambda lorcana-room (เรียลไทม์ 2 ผู้เล่น)&lt;/b&gt;&lt;br&gt;&lt;b&gt;Input:&lt;/b&gt; JSON {action / gameAction / type, roomId, username, ...} พร้อม connectionId จาก API Gateway&lt;br&gt;&lt;b&gt;$connect:&lt;/b&gt; ตอบ 200 (ยังไม่ตรวจตัวตน) | &lt;b&gt;$disconnect:&lt;/b&gt; หาแถวของ connection, มาร์กสถานะ disconnected, แจ้งอีกฝ่าย OPPONENT_DISCONNECTED (เวลาคืนที่นั่ง 60 วินาที)&lt;br&gt;&lt;b&gt;CREATE_ROOM:&lt;/b&gt; สุ่มรหัส 6 หลัก (ลองสูงสุด 10 ครั้ง) บันทึก player1 → ตอบ ROOM_CREATED | &lt;b&gt;JOIN_ROOM:&lt;/b&gt; ตรวจห้องเต็มและชื่อซ้ำ บันทึก player2 → ส่ง GAME_START ทั้งสองฝ่าย&lt;br&gt;&lt;b&gt;MATCHMAKING_JOIN / LEAVE:&lt;/b&gt; scan คิวที่รออยู่ จับคู่รายแรก → MATCH_FOUND หรือ WAITING | &lt;b&gt;REJOIN_ROOM:&lt;/b&gt; ผูกที่นั่งเดิมตามชื่อผู้ใช้ → PLAYER_RECONNECTED&lt;br&gt;&lt;b&gt;ข้อความเกมอื่น&lt;/b&gt; (CARD_MOVED, LORE_UPDATED, QUEST_DONE, TURN_PASSED, CHAT ...) และ undo: ส่งต่อให้สมาชิกห้องยกเว้นผู้ส่ง ผ่าน PostToConnection" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2E0;strokeColor=#ED7100;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;align=left;spacingLeft=8;spacingRight=64;" vertex="1" parent="1"><mxGeometry x="330" y="80" width="880" height="190" as="geometry"/></mxCell>
        <mxCell id="r1o" value="&lt;b&gt;ปลายทาง&lt;/b&gt;&lt;br&gt;DynamoDB LorcanaRoomStateV2 (PK roomId, SK connectionId)&lt;br&gt;DynamoDB LorcanaMatchmaking (PK connectionId)&lt;br&gt;API Gateway PostToConnection → Browser ของอีกฝ่าย" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EAFB;strokeColor=#3B48CC;fontSize=11;align=left;spacingLeft=8;spacingRight=64;" vertex="1" parent="1"><mxGeometry x="1280" y="80" width="340" height="110" as="geometry"/></mxCell>
        <mxCell id="r1n" value="&lt;b&gt;ข้อจำกัดที่รู้อยู่แล้ว&lt;/b&gt;: $connect ไม่ยืนยัน JWT, relay ไม่ตรวจว่าผู้ส่งเป็นสมาชิกห้อง, ค่าที่ client ส่งถูกส่งต่อโดยไม่ตรวจ schema ผู้เล่นรายงานผลชนะเองได้ (แผนแก้อยู่ระหว่างเตรียม)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1280" y="205" width="340" height="75" as="geometry"/></mxCell>
        <mxCell id="r1a" value="invoke ตาม route" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;strokeColor=#2DA44E;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="r1t" target="r1c"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="r1b" value="อ่าน/เขียนสถานะ + ส่งข้อความ" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;strokeColor=#2DA44E;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="r1c" target="r1o"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="r2t" value="&lt;b&gt;Trigger&lt;/b&gt;&lt;br&gt;SQS lorcana-deck-analyzer&lt;br&gt;ส่งโดย Express ตอน POST /decks: {deckId, userId, cards[]}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDE7F1;strokeColor=#E7157B;fontSize=11;align=left;spacingLeft=8;spacingRight=64;" vertex="1" parent="1"><mxGeometry x="20" y="330" width="240" height="110" as="geometry"/></mxCell>
        <mxCell id="r2c" value="&lt;b&gt;2. Lambda lorcana-analyzer (วิเคราะห์เด็คเบื้องหลัง)&lt;/b&gt;&lt;br&gt;&lt;b&gt;Input:&lt;/b&gt; SQS batch; แต่ละ record parse เป็น {deckId, userId, cards[]}&lt;br&gt;&lt;b&gt;ตรวจ:&lt;/b&gt; ขาดฟิลด์หรือ cards ไม่ใช่ array → throw&lt;br&gt;&lt;b&gt;คำนวณ:&lt;/b&gt; analyzeDeck(cards) เป็นฟังก์ชันล้วน ได้ cost curve และสัดส่วนการ์ด inkable&lt;br&gt;&lt;b&gt;เขียน:&lt;/b&gt; UpdateItem DecksTable key {deckId, userId} SET analysis&lt;br&gt;&lt;b&gt;ข้อผิดพลาด:&lt;/b&gt; เก็บ messageId ของ record ที่ล้มใส่ batchItemFailures (partial batch) ข้อความจะกลับเข้าคิวและลองใหม่ ครบ maxReceiveCount 3 ครั้งเข้า analyzer-dlq&lt;br&gt;&lt;b&gt;เงื่อนไข:&lt;/b&gt; event source mapping ต้องมี ReportBatchItemFailures และ State = Enabled (ถ้า Disabled ข้อความจะค้างในคิว)&lt;br&gt;&lt;b&gt;หมายเหตุ:&lt;/b&gt; EC2 คำนวณ analyzeDeck ด้วยโค้ดชุดเดียวกัน (backend/shared/deckAnalysis.ts) ตอน POST /decks อยู่แล้ว Lambda ตัวนี้จึงเป็นขั้นคำนวณซ้ำแบบ asynchronous ผลเหมือนกัน" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2E0;strokeColor=#ED7100;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;align=left;spacingLeft=8;spacingRight=64;" vertex="1" parent="1"><mxGeometry x="330" y="330" width="880" height="170" as="geometry"/></mxCell>
        <mxCell id="r2o" value="&lt;b&gt;ปลายทาง&lt;/b&gt;&lt;br&gt;DynamoDB DecksTable (ฟิลด์ analysis)&lt;br&gt;ล้มครบ 3 ครั้ง → SQS analyzer-dlq" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EAFB;strokeColor=#3B48CC;fontSize=11;align=left;spacingLeft=8;spacingRight=64;" vertex="1" parent="1"><mxGeometry x="1280" y="330" width="340" height="100" as="geometry"/></mxCell>
        <mxCell id="r2a" value="event source mapping" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;strokeColor=#ED7100;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="r2t" target="r2c"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="r2b" value="UpdateItem / DLQ" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;strokeColor=#ED7100;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="r2c" target="r2o"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="r3t" value="&lt;b&gt;Trigger&lt;/b&gt;&lt;br&gt;SQS match-history&lt;br&gt;รับสำเนา event match.finished จาก SNS lorcana-match-events" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDE7F1;strokeColor=#E7157B;fontSize=11;align=left;spacingLeft=8;spacingRight=64;" vertex="1" parent="1"><mxGeometry x="20" y="560" width="240" height="110" as="geometry"/></mxCell>
        <mxCell id="r3c" value="&lt;b&gt;3. Lambda match-history (บันทึกประวัติแมตช์)&lt;/b&gt;&lt;br&gt;&lt;b&gt;Input:&lt;/b&gt; {matchId, winner, loser, winnerLore, loserLore, turns, finishedAt}&lt;br&gt;&lt;b&gt;ตรวจ:&lt;/b&gt; ขาด matchId, winner, loser หรือ lore ของทั้งสองฝ่าย → throw&lt;br&gt;&lt;b&gt;สร้าง key:&lt;/b&gt; sortKey = finishedAt#matchId (ถ้าไม่มี finishedAt ใช้เวลาปัจจุบัน)&lt;br&gt;&lt;b&gt;เขียน 2 แถว:&lt;/b&gt; userId = ผู้ชนะ (result WIN, myLore, opponentLore) และ userId = ผู้แพ้ (result LOSS)&lt;br&gt;&lt;b&gt;ความซ้ำ:&lt;/b&gt; ข้อความซ้ำเขียนทับ key เดิมด้วยค่าเดิม ผลจึงไม่เพี้ยน&lt;br&gt;&lt;b&gt;ข้อผิดพลาด:&lt;/b&gt; batchItemFailures → ลองใหม่ → DLQ ของคิว match-history" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2E0;strokeColor=#ED7100;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;align=left;spacingLeft=8;spacingRight=64;" vertex="1" parent="1"><mxGeometry x="330" y="560" width="880" height="170" as="geometry"/></mxCell>
        <mxCell id="r3o" value="&lt;b&gt;ปลายทาง&lt;/b&gt;&lt;br&gt;DynamoDB LorcanaMatchHistory&lt;br&gt;PK userId | SK finishedAt#matchId&lt;br&gt;อ่านด้วย GET /api/matches (20 รายการล่าสุด)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EAFB;strokeColor=#3B48CC;fontSize=11;align=left;spacingLeft=8;spacingRight=64;" vertex="1" parent="1"><mxGeometry x="1280" y="560" width="340" height="100" as="geometry"/></mxCell>
        <mxCell id="r3a" value="event source mapping" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;strokeColor=#ED7100;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="r3t" target="r3c"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="r3b" value="PutItem x2" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;strokeColor=#ED7100;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="r3c" target="r3o"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="r4t" value="&lt;b&gt;Trigger&lt;/b&gt;&lt;br&gt;SQS player-stats&lt;br&gt;รับสำเนา event match.finished จาก SNS (คิวคู่ขนานกับ match-history)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDE7F1;strokeColor=#E7157B;fontSize=11;align=left;spacingLeft=8;spacingRight=64;" vertex="1" parent="1"><mxGeometry x="20" y="790" width="240" height="110" as="geometry"/></mxCell>
        <mxCell id="r4c" value="&lt;b&gt;4. Lambda player-stats (สถิติผู้เล่น สำหรับ leaderboard)&lt;/b&gt;&lt;br&gt;&lt;b&gt;Input:&lt;/b&gt; {matchId, winner, loser, ...}; ขาด matchId, winner หรือ loser → throw&lt;br&gt;&lt;b&gt;ขั้น 1 กันนับซ้ำ:&lt;/b&gt; PutItem marker key userId = DEDUPE#matchId แบบ conditional (attribute_not_exists, เก็บ 7 วันด้วย TTL) ถ้ามีอยู่แล้ว = เคยประมวลผลแล้ว ข้ามและยืนยันข้อความ&lt;br&gt;&lt;b&gt;ขั้น 2 ผู้ชนะ:&lt;/b&gt; UpdateItem ADD wins 1, games 1 (atomic) | &lt;b&gt;ขั้น 3 ผู้แพ้:&lt;/b&gt; UpdateItem ADD losses 1, games 1&lt;br&gt;&lt;b&gt;ข้อผิดพลาด:&lt;/b&gt; batchItemFailures → ลองใหม่ → DLQ ของคิว player-stats&lt;br&gt;&lt;b&gt;ผลต่อระบบ:&lt;/b&gt; GET /api/leaderboard อ่านตารางนี้ (ผ่านแคช Redis 60 วินาที)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2E0;strokeColor=#ED7100;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;align=left;spacingLeft=8;spacingRight=64;" vertex="1" parent="1"><mxGeometry x="330" y="790" width="880" height="160" as="geometry"/></mxCell>
        <mxCell id="r4o" value="&lt;b&gt;ปลายทาง&lt;/b&gt;&lt;br&gt;DynamoDB LorcanaPlayerStats&lt;br&gt;wins / losses / games ต่อผู้เล่น" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EAFB;strokeColor=#3B48CC;fontSize=11;align=left;spacingLeft=8;spacingRight=64;" vertex="1" parent="1"><mxGeometry x="1280" y="790" width="340" height="90" as="geometry"/></mxCell>
        <mxCell id="r4a" value="event source mapping" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;strokeColor=#ED7100;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="r4t" target="r4c"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="r4b" value="ADD (atomic)" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;strokeColor=#ED7100;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="r4c" target="r4o"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="note" value="หมายเหตุ: Lambda รุ่นเก่า (lorcana-auth-register, auth/deck ใน backend/serverless) ยังถูก deploy อยู่ แต่เส้นทางใช้งานจริงของ สมัคร/ล็อกอิน/เด็ค คือ Express บน EC2 (หน้า 2) | ทุก Lambda ใช้ LabRole | event source mapping ของ analyzer, match-history, player-stats ต้องเป็น Enabled และ ensure_pipeline.ps1 เปิดกลับให้อัตโนมัติถ้าเจอ Disabled" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#9CA3AF;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="20" y="990" width="1600" height="60" as="geometry"/></mxCell>
