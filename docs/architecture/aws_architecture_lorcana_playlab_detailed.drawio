<mxCell id="r7c" value="&lt;b&gt;GET /leaderboard&lt;/b&gt;: ดู Redis ก่อน ไม่พบค่อย Scan PlayerStats แล้วเขียนแคช" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ED7100;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;" vertex="1" parent="1"><mxGeometry x="590" y="762" width="330" height="78" as="geometry"/></mxCell>
