# Backend (backend/server.ts). On EC2 these come from SSM via scripts/ec2_user_data.sh.
PORT=3001
AWS_REGION=us-east-1

# DynamoDB table names
USERS_TABLE=UsersTable
DECKS_TABLE=DecksTable
ROOM_TABLE=LorcanaRoomStateV2
MATCHMAKING_TABLE=LorcanaMatchmaking
MATCH_HISTORY_TABLE=LorcanaMatchHistory
PLAYER_STATS_TABLE=LorcanaPlayerStats

# Optional: leave empty to disable the feature locally
LORCANA_SQS_URL=
MATCH_EVENTS_TOPIC_ARN=
CACHE_ENDPOINT=

# Required when NODE_ENV=production (the server exits without them). Use long random values.
JWT_SECRET=your_jwt_secret_here
ADMIN_PASSCODE=your_admin_passcode_here

# Frontend build (Vite). Defaults: API on same-origin /api, WebSocket on same-host /ws.
# Local dev against `cd backend && npm run dev`: VITE_API_BASE_URL=http://localhost:3001/api, VITE_WS_ENDPOINT=ws://localhost:3001
VITE_API_BASE_URL=
VITE_WS_ENDPOINT=
